# Copy to .env.production on the Ubuntu host and replace every placeholder.
POSTGRES_DB=arquitectura
POSTGRES_USER=arquitectura
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://arquitectura:replace-with-a-long-random-password@postgres:5432/arquitectura

AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://example.com
SITE_URL=https://example.com
SITE_CONTENT_MODE=live
UPLOADS_ROOT=/data/uploads

ADMIN_EMAIL=
ADMIN_PASSWORD=
