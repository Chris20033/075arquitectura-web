# Local development only. Never reuse these credentials in production.
DATABASE_URL="postgresql://arquitectura:local_dev_only@127.0.0.1:5432/arquitectura"
TEST_DATABASE_URL="postgresql://arquitectura_test:local_test_only@127.0.0.1:5433/arquitectura_test"

# Generate a unique secret for each environment. Never commit the real value.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Required only by `npm run db:bootstrap-admin`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public content remains visibly provisional until real copy and imagery are approved.
SITE_CONTENT_MODE="demo"

# Cloudinary integration is implemented in Sprint 7. Never expose the API secret.
CLOUDINARY_URL=""
CLOUDINARY_ASSET_FOLDER="075Arquitectura/projects"
